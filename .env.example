# Environment
NODE_ENV=development

# Browser calls this same-origin path; Next.js proxies to API_PROXY_TARGET
NEXT_PUBLIC_API_BASE_URL=/api

# Upstream API used by next.config.ts rewrites (server-side only)
API_PROXY_TARGET=https://neptune-be-stag.codeswift.org/api

# Backend URL
NEXT_PUBLIC_API_URL=https://neptune-be-stag.codeswift.org/api

# Cloudinary
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=dgwnm39m7
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=my_uploads     